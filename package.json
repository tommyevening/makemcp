{
  "name": "makemcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude understand Make (make.com) and build working scenarios.",
  "type": "module",
  "bin": {
    "makemcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "build:db": "tsx src/knowledge/build.ts",
    "scrape": "tsx src/knowledge/scrape.ts",
    "catalog": "tsx src/knowledge/catalog.ts",
    "applyUsage": "tsx src/knowledge/applyUsage.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "make.com",
    "integromat",
    "automation",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
