# Make API credentials (paid plan required for scenario management).
# Create a token in Make: Profile -> API/SDK -> Add token.
# Recommended scopes:
#   scenarios:read scenarios:write scenarios:run user:read connections:read hooks:read hooks:write teams:read sdk-apps:read
MAKE_API_KEY=your-make-api-token

# Your Make team id (number). Find it in the URL when viewing your team, or via GET /api/v2/teams.
MAKE_TEAM_ID=123456

# Your Make zone/region, e.g. eu1, eu2, us1, us2. Used to build the base URL https://<zone>.make.com/api/v2
MAKE_ZONE=eu2

# Optional: full override of the API base URL. If set, takes precedence over MAKE_ZONE.
# MAKE_API_URL=https://eu2.make.com/api/v2
